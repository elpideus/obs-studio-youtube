prepare() {
  cd $pkgname

  git submodule init

  git config submodule."plugins/obs-browser".url "${srcdir}/${pkgname}"-obs-browser
  git config submodule."plugins/obs-websocket".url "${srcdir}/${pkgname}"-obs-websocket
  git config submodule."plugins/win-dshow/libdshowcapture".url "${srcdir}/${pkgname}"-libdshowcapture

  git -c protocol.file.allow=always submodule update --init --recursive

  # use FindCEF provided by system CEF
  rm cmake/finders/FindCEF.cmake

  # set rpath to /usr/lib/cef for obs-browser plugin
  sed -e 's|INSTALL_RPATH ".*"|INSTALL_RPATH "/usr/lib/cef/"|' -i plugins/obs-browser/cmake/os-linux.cmake
}

_obs_youtube_credentials() {
  # Your own Google OAuth "Desktop app" client. Never commit or share these values.
  YOUTUBE_CLIENTID="${OBS_YOUTUBE_CLIENTID:-}"
  YOUTUBE_SECRET="${OBS_YOUTUBE_SECRET:-}"
  local _file="${OBS_YOUTUBE_CREDENTIALS:-${XDG_CONFIG_HOME:-$HOME/.config}/obs-youtube/credentials.env}"
  if [[ ( -z $YOUTUBE_CLIENTID || -z $YOUTUBE_SECRET ) && -r $_file ]]; then
    # Parsed, not sourced: only the two KEY="value" lines are read.
    YOUTUBE_CLIENTID=$(sed -n 's/^YOUTUBE_CLIENTID="\{0,1\}\([^"]*\)"\{0,1\}[[:space:]]*$/\1/p' "$_file")
    YOUTUBE_SECRET=$(sed -n 's/^YOUTUBE_SECRET="\{0,1\}\([^"]*\)"\{0,1\}[[:space:]]*$/\1/p' "$_file")
  fi
  if [[ $YOUTUBE_CLIENTID != *.apps.googleusercontent.com || -z $YOUTUBE_SECRET ]]; then
    error "No Google OAuth client found for the YouTube integration."
    plainerr "Create one (see https://github.com/elpideus/obs-studio-youtube#google-api-client),"
    plainerr "then put it in $_file or export OBS_YOUTUBE_CLIENTID / OBS_YOUTUBE_SECRET."
    return 1
  fi
}

build() {
  local YOUTUBE_CLIENTID YOUTUBE_SECRET
  _obs_youtube_credentials || return 1

  local _cef_api_version=$(grep -oP 'CEF_API_VERSION_LAST CEF_API_VERSION\_\K[0-9]+' /usr/include/cef/include/cef_api_versions.h)
  echo Setting CEF_API_VERSION to $_cef_api_version

  local cmake_options=(
    -DYOUTUBE_CLIENTID="$YOUTUBE_CLIENTID"
    -DYOUTUBE_SECRET="$YOUTUBE_SECRET"
    -DYOUTUBE_CLIENTID_HASH=0
    -DYOUTUBE_SECRET_HASH=0
    -B build
    -S $pkgname
    -DCMAKE_INSTALL_PREFIX="/usr"
    -DCMAKE_COMPILE_WARNING_AS_ERROR=OFF
    # mbedtls 4 not supported yet
    # https://github.com/obsproject/obs-studio/issues/13601
    -DMbedTLS_DIR="/usr/lib/mbedtls3/cmake/MbedTLS"
    -DENABLE_BROWSER=ON
    -DCEF_API_VERSION=$_cef_api_version
    -DENABLE_VST=ON
    -DENABLE_VLC=OFF
    -DENABLE_NEW_MPEGTS_OUTPUT=OFF
    -DENABLE_AJA=OFF
    -DENABLE_JACK=ON
    -DENABLE_LIBFDK=ON
    -DENABLE_WEBRTC=ON
    -DOBS_VERSION_OVERRIDE="$pkgver"
    -DENABLE_WEBSOCKET=ON
  )
  cmake "${cmake_options[@]}"
  # feature-youtube.cmake silently skips the integration if anything is missing
  grep -qs -- '-DYOUTUBE_ENABLED' build/frontend/CMakeFiles/obs-studio.dir/flags.make build/build.ninja \
    || { error "cmake did not enable the YouTube integration"; return 1; }
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
